<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RustDeskHop</AssemblyName>
    <Product>RustDeskHop</Product>
    <Description>Independent open-source network companion for RustDesk</Description>
    <RootNamespace>Simultria.RustDeskCompanion</RootNamespace>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <BrandingSource>$(MSBuildProjectDirectory)\Assets\RustDeskHop.svg</BrandingSource>
  </PropertyGroup>
  <ItemGroup>
    <None Update="settings.local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <None Update="LICENSE;README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Assets\RustDeskHop.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="THIRD-PARTY-NOTICES.md;PRIVACY.md;SECURITY.md;CONTRIBUTING.md;docs\**\*" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="GenerateApplicationBranding"
          Inputs="$(BrandingSource);$(MSBuildProjectDirectory)\tools\Build-ApplicationIcon.ps1;$(MSBuildProjectDirectory)\tools\BrandingRenderer\Program.cs;$(MSBuildProjectDirectory)\tools\BrandingRenderer\BrandingRenderer.csproj"
          Outputs="$(IntermediateOutputPath)branding\RustDeskHop.ico;$(IntermediateOutputPath)branding\RustDeskHop.png">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\Build-ApplicationIcon.ps1&quot; -Source &quot;$(BrandingSource)&quot; -Destination &quot;$(IntermediateOutputPath)branding\RustDeskHop.ico&quot; -LogoDestination &quot;$(IntermediateOutputPath)branding\RustDeskHop.png&quot;" />
  </Target>
  <Target Name="UseApplicationBranding" BeforeTargets="AssignTargetPaths" DependsOnTargets="GenerateApplicationBranding">
    <PropertyGroup>
      <ApplicationIcon>$(IntermediateOutputPath)branding\RustDeskHop.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)branding\RustDeskHop.ico" LogicalName="RustDeskHop.Assets.RustDeskHop.ico" />
      <EmbeddedResource Include="$(IntermediateOutputPath)branding\RustDeskHop.png" LogicalName="RustDeskHop.Assets.RustDeskHop.png" />
      <None Include="$(IntermediateOutputPath)branding\RustDeskHop.ico"
            Link="Assets\RustDeskHop.ico" TargetPath="Assets\RustDeskHop.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
      <None Include="$(IntermediateOutputPath)branding\RustDeskHop.png"
            Link="Assets\RustDeskHop.png" TargetPath="Assets\RustDeskHop.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
      <FileWrites Include="$(IntermediateOutputPath)branding\RustDeskHop.ico;$(IntermediateOutputPath)branding\RustDeskHop.png" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs;tools\**\*.cs" />
    <None Remove="tests\**\*" />
  </ItemGroup>
</Project>
